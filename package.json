{
  "name": "ezdsh",
  "version": "0.8.15.1",
  "description": "A desktop client for DeepSeek Harness.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "npm": ">=9.0.0"
  },
  "main": "./out/main/index.js",
  "author": "EzDSH",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:runtime": "node scripts/check-runtime.mjs",
    "dsh:install": "CI=true pnpm --dir vendor/deepseek-harness install --frozen-lockfile",
    "dsh:build": "CI=true pnpm --dir vendor/deepseek-harness run build",
    "stage:node-runtime": "node scripts/stage-node-runtime.mjs",
    "stage:dsh-runtime": "node scripts/stage-dsh-runtime.mjs",
    "stage:runtime": "npm run stage:node-runtime && npm run stage:dsh-runtime",
    "verify:runtime": "node scripts/verify-runtime-bundle.mjs",
    "verify:package:mac": "node scripts/verify-runtime-bundle.mjs \"dist/mac-arm64/Ez DSH.app/Contents/Resources/app/out\"",
    "postinstall": "npm run check:runtime && npm run dsh:install",
    "prepare:package": "npm run dsh:install && npm run dsh:build && npm run build && npm run stage:runtime && npm run verify:runtime",
    "package:dir": "npm run prepare:package && electron-builder --dir",
    "package:mac": "npm run prepare:package && electron-builder --mac --publish never && npm run verify:package:mac",
    "package:mac:zip": "npm run prepare:package && electron-builder --mac zip --publish never && npm run verify:package:mac",
    "package:mac:release": "npm run prepare:package && electron-builder --mac --publish never -c.mac.forceCodeSigning=true && npm run verify:package:mac"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "node-bin-darwin-arm64": "24.18.0",
    "pnpm": "11.7.0",
    "typescript": "5.9.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.2"
  },
  "build": {
    "appId": "com.ezdsh.desktop",
    "productName": "Ez DSH",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "out/dsh-runtime/node_modules/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "logo.png",
        "to": "logo.png"
      }
    ],
    "icon": "logo.png",
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://ezdsh.vercel.app/updates/"
      }
    ],
    "extraMetadata": {
      "version": "0.8.15"
    }
  }
}
