# Optional development update check. The URL should end with /updates/ and expose
# electron-builder metadata such as latest-mac.yml or latest.yml.
EZDSH_UPDATE_FEED_URL=http://update.ezdsh.com/updates/

# Optional override for the dynamic update resolver. Packaged builds use the
# production resolver by default; setting this enables resolver testing in dev.
EZDSH_UPDATE_RESOLVE_URL=http://update.ezdsh.com/api/update/resolve
