{
  "name": "mode-menu-plus",
  "description": "Mode menu (agent preset) enhancements for ezdsh: a hub link pinned in the menu footer and tuned typography on the new-session screen.",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": { "default": "./src/index.js" },
    "./client": { "default": "./src/client.js" },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-store": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.3-alpha.2"
  }
}
